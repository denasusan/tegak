# Salin file ini menjadi ".env" sebelum menjalankan aplikasi

# Connection string database PostgreSQL dari project Supabase Anda
# (Project Settings → Database → Connection string di dashboard Supabase).
#
# DATABASE_URL: pakai "Connection pooling" (Transaction mode, port 6543) —
# dipakai aplikasi saat runtime, wajib untuk lingkungan serverless (Vercel).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: pakai koneksi langsung (port 5432) — dipakai Prisma khusus
# saat menjalankan `prisma migrate` (pooler tidak mendukung perintah DDL).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Kunci rahasia untuk menandatangani session login (cookie).
# Ganti dengan string acak yang panjang & rahasia di produksi, misalnya hasil dari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-rahasia-yang-panjang-dan-acak"

# Kredensial OAuth untuk tombol "Masuk dengan Google" (dari Google Cloud
# Console → APIs & Services → Credentials → OAuth client ID, tipe "Web
# application"). Redirect URI yang harus didaftarkan di sana:
#   http://localhost:3000/api/auth/google/callback       (development)
#   https://<domain-vercel-anda>/api/auth/google/callback (production)
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="ganti-dengan-client-secret-dari-google-cloud-console"
